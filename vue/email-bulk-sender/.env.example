# 使用你已验证的企业邮箱 / 邮件服务商 SMTP 凭据。不要将 .env 提交到 Git。
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password-or-api-key

# 必须是服务商已验证的发件人地址。
EMAIL_FROM="Northstar Studio <hello@your-verified-domain.com>"
EMAIL_REPLY_TO=reply@your-verified-domain.com
PORT=3001
SEND_INTERVAL_MS=1000
